{
  "name": "app1",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "cp db.json /tmp/taskly-db.json && bun x json-server /tmp/taskly-db.json --host 0.0.0.0 --port 3000 & NG_CLI_ANALYTICS=false bun x ng serve --host 0.0.0.0 --port 5000",
    "build": "ng build",
    "build:ci": "NG_CLI_ANALYTICS=false bun x ng build",
    "typecheck": "bun x tsc -p tsconfig.app.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "NG_CLI_ANALYTICS=false bun x ng test --watch=false",
    "api": "node server.js",
    "api:stop": "kill $(lsof -t -i :3000)"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.30",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.30",
    "@angular/router": "20.3.30",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@ngrx/store-devtools": "^20.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "autoprefixer": "10.4.21",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "json-server": "^1.0.0-beta.3",
    "postcss": "8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "3.4.17",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.36",
    "@angular/cli": "20.3.36",
    "@angular/compiler-cli": "20.3.30",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tar": "7.5.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "pacote": {
      "tar": "7.5.2"
    }
  }
}
